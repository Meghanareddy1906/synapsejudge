# ---- Core ----
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ---- Persistence ----
MONGO_URI=mongodb://127.0.0.1:27017/online_judge
# Host port docker-compose publishes Redis on. Change both lines together if
# something else on your machine already owns 6379.
REDIS_HOST_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Judge sandbox ----
# Absolute host path used to stage submission source before mounting into the runner.
SANDBOX_HOST_DIR=./.tmp-submissions
JUDGE_CONCURRENCY=2
DEFAULT_TIME_LIMIT_MS=2000
DEFAULT_MEMORY_LIMIT_MB=256
COMPILE_TIMEOUT_MS=10000


# ---- Plagiarism detection ----
# local  = deterministic k-gram feature-hashing embeddings (no API key required)
# voyage = Voyage AI embeddings (set VOYAGE_API_KEY)
EMBEDDING_PROVIDER=local
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-code-3
PLAGIARISM_THRESHOLD=0.90
