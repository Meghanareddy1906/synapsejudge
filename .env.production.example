# SynapseJudge — production environment.
# Copy to .env on the server and fill in the marked values.
#
#   cp .env.production.example .env
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# ---- Core ----
NODE_ENV=production
PORT=4000
# The public origin(s) the browser loads the app from. Comma-separate to allow
# more than one. Must match exactly, scheme included — a mismatch here is the
# usual cause of "CORS blocked" after going live.
CLIENT_ORIGIN=https://synapsejudge.duckdns.org

# Nginx serves client/dist directly (see deploy/nginx/synapsejudge.conf), so
# leave this false. Set it to true only if you are running without Nginx.
SERVE_CLIENT=false

# ---- Persistence ----
# Both run as containers from docker-compose.yml, bound to localhost only.
MONGO_URI=mongodb://127.0.0.1:27017/online_judge
REDIS_HOST_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# ---- Auth ----
# REQUIRED. The server refuses to start in production without this, and
# deploy.sh refuses to deploy while it is still the placeholder.
JWT_SECRET=replace-me
JWT_EXPIRES_IN=7d

# ---- Judge sandbox ----
# Absolute path on the host. The worker stages submitted source here and
# bind-mounts it read-only into each container.
SANDBOX_HOST_DIR=/home/ubuntu/synapseJudge/.tmp-submissions
# Containers in flight at once. Roughly one per vCPU; on a t3.small (2 vCPU)
# leave this at 2 — the API and Mongo need headroom too.
JUDGE_CONCURRENCY=2
DEFAULT_TIME_LIMIT_MS=2000
DEFAULT_MEMORY_LIMIT_MB=256
COMPILE_TIMEOUT_MS=10000


# ---- Plagiarism detection ----
# local = deterministic k-gram embeddings, no API key, no network call.
EMBEDDING_PROVIDER=local
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-code-3
PLAGIARISM_THRESHOLD=0.90
